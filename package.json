{
  "name": "studyverse",
  "version": "0.1.0",
  "private": true,
  "description": "An elegant, all-in-one digital study workspace.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @studyverse/web --filter @studyverse/api dev",
    "dev:web": "pnpm --filter @studyverse/web dev",
    "dev:api": "pnpm --filter @studyverse/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.2"
  }
}
